#include <iostream>
#include <vector>
#include <unordered_map>

int subarraySum(const std::vector<int>& nums, int k) {
    std::unordered_map<int, int> sumCounts;
    
    sumCounts[0] = 1;
    
    int currentSum = 0;
    int totalSubarrays = 0;
    
    for (int num : nums) {
        currentSum += num; 
        if (sumCounts.find(currentSum - k) != sumCounts.end()) {
            totalSubarrays += sumCounts[currentSum - k];
        }
        
        sumCounts[currentSum]++;
    }
    
    return totalSubarrays;
}

int main() {
    std::vector<int> nums = {1, 1, 1};
    int k = 2;
    
    std::cout << "Total subarrays: " << subarraySum(nums, k) << "\n"; 
    return 0;
}
