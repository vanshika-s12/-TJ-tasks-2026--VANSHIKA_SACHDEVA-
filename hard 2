#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
vector<vector<int>> adj;
int maxDist = -1;
int farthestNode = -1;
void dfs(int node, int parent, int currentDist) {
    if (currentDist > maxDist) {
        maxDist = currentDist;
        farthestNode = node;
    }
    
    for (int child : adj[node]) {
        if (child != parent) {
            dfs(child, node, currentDist + 1);
        }
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;
    if (n == 1) {
        cout << "Leaves: 1\n";
        cout << "Diameter: 0\n";
        return 0;
    }
    adj.resize(n + 1);
    for (int i = 0; i < n - 1; ++i) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    cout << "Leaves: ";
    for (int i = 1; i <= n; ++i) {
        if (adj[i].size() == 1) {
            cout << i << " ";
        }
    }
    cout << "\n";
    maxDist = -1;
    dfs(1, 0, 0); 
 int startNode = farthestNode;
    maxDist = -1;
    dfs(startNode, 0, 0);
    cout << "Diameter: " << maxDist << "\n";

    return 0;
}

